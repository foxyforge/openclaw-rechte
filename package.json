{
  "name": "@foxyforge/openclaw-rechte",
  "version": "0.6.0",
  "description": "Rights table for OpenClaw: per channel and tool allow, ask or off – enforced in code, not in the prompt. /rights (alias /rechte).",
  "type": "module",
  "license": "MIT",
  "author": "Chris (foxyforge)",
  "repository": {
    "type": "git",
    "url": "https://github.com/foxyforge/openclaw-rechte"
  },
  "homepage": "https://github.com/foxyforge/openclaw-rechte#readme",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "permissions",
    "rights",
    "tool-policy",
    "telegram",
    "approval"
  ],
  "files": [
    "index.js",
    "rechte.js",
    "openclaw.plugin.json",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs/*.jpg"
  ],
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.6"
    },
    "build": {
      "openclawVersion": "2026.9.6"
    }
  },
  "scripts": {
    "test": "node --test"
  }
}
